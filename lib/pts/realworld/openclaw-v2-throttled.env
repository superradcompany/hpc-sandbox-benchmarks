
# Candidate openclaw-v2-all-throttled-fd-v1. Only these four commands change.
# Upstream keeps all projects/shards; bounds native Go compiler resources.
TASK_CMD_lint_oxlint="OPENCLAW_LOCAL_CHECK=1 OPENCLAW_LOCAL_CHECK_MODE=throttled pnpm lint"
TASK_CMD_typecheck="OPENCLAW_LOCAL_CHECK=1 OPENCLAW_LOCAL_CHECK_MODE=throttled pnpm tsgo:prod"
TASK_CMD_lint_extensions="OPENCLAW_LOCAL_CHECK=1 OPENCLAW_LOCAL_CHECK_MODE=throttled node scripts/run-oxlint-shards.mjs --only extensions"
TASK_CMD_test_unit_fast="OPENCLAW_VITEST_MAX_WORKERS=1 pnpm test:unit:fast"
# Explicit V2 runtime: sqlite.setAuthorizer requires Node24.10 or later.
NODE_VERSION="24.16.0"
