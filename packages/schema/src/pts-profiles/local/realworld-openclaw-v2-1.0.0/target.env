# OpenClaw workload v2: release 2026.9.2. All metrics have a new profile identity;
# historical v1 measurements remain in the catalog and are not timing equivalents.
REPO_URL="https://github.com/openclaw/openclaw.git"
PIN_SHA="3928bad9badfcb6c7d140530435e806fb8092190"
NODE_VERSION="22"

TASK_CMD_git_clone=""
TASK_CMD_cold_install="pnpm install --frozen-lockfile"
TASK_CMD_lint_oxlint="OPENCLAW_LOCAL_CHECK=0 pnpm lint"
# Upstream removed lint:extensions:channels; this is its current extension lint task.
TASK_CMD_lint_extensions="pnpm lint:extensions"
# v2 tsgo:prod includes UI in addition to core and extensions.
TASK_CMD_typecheck="OPENCLAW_LOCAL_CHECK=0 pnpm tsgo:prod"
# Upstream removed shrinkwrap in f6131a4fbf. Run its real replacement, without generating
# a tracked file merely to manufacture a successful check of that same file.
TASK_CMD_npm_lock_check="OPENCLAW_LOCAL_CHECK=0 pnpm deps:npm-lock:check"
TASK_CMD_test_unit_fast="pnpm test:unit:fast"
TASK_CMD_test_types="pnpm check:test-types"
